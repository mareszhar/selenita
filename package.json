{
  "name": "@mszr/selenita",
  "type": "module",
  "version": "0.4.0",
  "packageManager": "bun@1.4.2",
  "description": "Test what your users see in their editor — completions, hovers, diagnostics, signature help, and rename, with tagged-template fixtures.",
  "author": "Mares",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/mareszhar/selenita#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mareszhar/selenita.git"
  },
  "bugs": {
    "url": "https://github.com/mareszhar/selenita/issues"
  },
  "keywords": [
    "typescript",
    "intellisense",
    "completions",
    "language-service",
    "testing",
    "dx",
    "editor",
    "vitest",
    "language-service-plugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "upi": "bunx npm-check-updates -i",
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p tests/consumer/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "validate": "bun run lint && bun run typecheck && bun run test",
    "val": "bun run validate",
    "release:patch": "bun scripts/release.ts patch",
    "release:minor": "bun scripts/release.ts minor",
    "release:major": "bun scripts/release.ts major",
    "prepublishOnly": "bun run verify",
    "test:package": "bun scripts/smoke-test-tarball.ts",
    "verify": "bun run validate && bun run build && bun run test:types && bun run test:package",
    "bench": "bun --expose-gc scripts/bench.ts"
  },
  "peerDependencies": {
    "vitest": "^5.0.3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@typescript/typescript6": "^6.0.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "eslint-plugin-format": "^2.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
