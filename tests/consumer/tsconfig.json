{
  // Validates that the built declarations compile cleanly from a consumer perspective.
  // The path-mapped imports resolve to the same .d.ts files that the `exports` map
  // points to, so type correctness is verified here. Package-level exports-map
  // resolution (i.e., whether `node_modules/@mszr/selenita` resolves correctly after
  // `npm install`) is covered by scripts/smoke-test-tarball.mjs, which runs a full
  // pack + install cycle as part of prepublishOnly.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@mszr/selenita": ["../../dist/index.d.ts"],
      "@mszr/selenita/*": ["../../dist/*.d.ts"]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"],
  "exclude": []
}
